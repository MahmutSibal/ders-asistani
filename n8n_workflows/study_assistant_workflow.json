{
  "name": "Akilli_Ders_ve_Soru_Asistani_Workflows",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "study-qa",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1a0b1c2d-0001-4000-8000-000000000001",
      "name": "Webhook: Soru-Cevap",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 200],
      "webhookId": "study-qa"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $json.body.model || 'qwen2.5:3b' }}\",\n  \"prompt\": \"Sen üniversite düzeyinde uzman bir {{ $json.body.course || 'Bilgisayar Mühendisliği' }} ders asistanısın. Öğrencinin sorusunu anlaşılır, akademik ve pedagojik olarak açıkla. Soru: {{ $json.body.question }}\",\n  \"stream\": false\n}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "1a0b1c2d-0001-4000-8000-000000000002",
      "name": "Ollama Soru Yanıtla",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"answer\": {{ JSON.stringify($json.response) }},\n  \"model\": {{ JSON.stringify($json.model) }},\n  \"timestamp\": {{ $now.toISO() }}\n}",
        "options": {}
      },
      "id": "1a0b1c2d-0001-4000-8000-000000000003",
      "name": "Soru Yanıtı Döndür",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "summarize-notes",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "2a0b1c2d-0002-4000-8000-000000000001",
      "name": "Webhook: Ders Notu Özetleme",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 420],
      "webhookId": "summarize-notes"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $json.body.model || 'qwen2.5:3b' }}\",\n  \"prompt\": \"Aşağıdaki {{ $json.body.course }} ders notunu analiz et ve sadece JSON olarak özetle: {\\\"summary\\\": \\\"kapsamlı özet\\\", \\\"key_points\\\": [\\\"anahtar madde 1\\\", \\\"anahtar madde 2\\\", \\\"anahtar madde 3\\\"]}\\n\\nNot:\\n{{ $json.body.content }}\",\n  \"format\": \"json\",\n  \"stream\": false\n}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "2a0b1c2d-0002-4000-8000-000000000002",
      "name": "Ollama Not Özetle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 420]
    },
    {
      "parameters": {
        "jsCode": "try {\n  const parsed = JSON.parse($input.first().json.response);\n  return [{ json: parsed }];\n} catch (e) {\n  return [{\n    json: {\n      summary: $input.first().json.response,\n      key_points: [\"Not özeti çıkarıldı\"]\n    }\n  }];\n}"
      },
      "id": "2a0b1c2d-0002-4000-8000-000000000003",
      "name": "JSON Doğrula (Özet)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 420]
    },
